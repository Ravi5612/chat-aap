{
  "expo": {
    "name": "ChatWarriors",
    "slug": "ChatWarriors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "chatwarriors",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "sdkVersion": "52.0.0",
    "runtimeVersion": "1.1.0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ravirai.chatwarriors",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFF5E6"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5E6",
          "image": "./assets/images/transparent.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ChatWarriors to access your camera",
          "microphonePermission": "Allow ChatWarriors to access your microphone"
        }
      ],
      "expo-av",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "packagingOptions": {
              "pickFirst": [
                "**/libreactnativejni.so",
                "**/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a5f0a97e-382f-4cd8-b3f2-b23797964284"
      }
    },
    "owner": "ravirai"
  }
}
