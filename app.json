{
  "expo": {
    "name": "ChatWarriors",
    "slug": "ChatWarriors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/circular_logo.png",
    "scheme": "chatwarriors",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "sdkVersion": "52.0.0",
    "runtimeVersion": "1.1.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ravirai.chatwarriors",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "ChatWarriors uses your location to help you find your lost device if you enable Device Tracker.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ChatWarriors uses your background location to help you find your lost device even when the app is closed.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.ravirai.chatwarriors",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/trimmed_logo.png",
        "backgroundColor": "#F68537"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5E6",
          "image": "./assets/images/logo.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ChatWarriors to access your camera",
          "microphonePermission": "Allow ChatWarriors to access your microphone"
        }
      ],
      "expo-av",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "packagingOptions": {
              "pickFirst": [
                "**/libreactnativejni.so",
                "**/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ChatWarriors to access your photos",
          "savePhotosPermission": "Allow ChatWarriors to save photos to your device",
          "isStandard": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ChatWarriors to access the microphone for voice typing",
          "speechRecognitionPermission": "Allow ChatWarriors to recognize your speech for voice typing"
        }
      ],
      [
        "expo-pip",
        {}
      ],
      "./plugins/withCustomSound.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2eb577a5-0aa5-401b-934a-651692bbdd05"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2eb577a5-0aa5-401b-934a-651692bbdd05",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
